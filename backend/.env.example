# Optional: override Chrome profile path
# Leave blank to auto-detect based on your OS
CHROME_PROFILE_PATH=

# Optional: override Chrome binary path
# Default is /Applications/Google Chrome.app/Contents/MacOS/Google Chrome (macOS)
CHROME_BINARY_PATH=

# Required for browser-use Cloud SDK v3 — get your key at https://browser-use.com
BROWSER_USE_API_KEY=bu_your_key_here

# Required for Exa research pipeline — get your key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_key_here

# Required for GPT card generation — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here
